<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <FablePackageType>library</FablePackageType>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>nfdi4plants</Authors>
    <Description>Portable YAML frontmatter and JSON codecs for ARC validation packages.</Description>
    <Summary>Pure validation-package serialization for .NET, JavaScript, and Python.</Summary>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>F#;FSharp;ARC;validation;metadata;YAML;JSON;fable-dotnet;fable-javascript;fable-python</PackageTags>
    <PackageProjectUrl>https://github.com/nfdi4plants/arc-validate-package-registry</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nfdi4plants/arc-validate-package-registry</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)/RELEASE_NOTES.md"))</PackageReleaseNotes>
    <PackageVersion>0.1.0-preview.4</PackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="SchemaUris.fs" />
    <Compile Include="DecodedValidationPackagesConfig.fs" />
    <Compile Include="FrontmatterLanguage.fs" />
    <Compile Include="Frontmatter.fs" />
    <Compile Include="Yaml\Encoding.fs" />
    <Compile Include="Yaml\Strict.fs" />
    <Compile Include="Yaml\CwlValidation.fs" />
    <Compile Include="Yaml\Encoders\Cwl.fs" />
    <Compile Include="Yaml\Encoders\Author.fs" />
    <Compile Include="Yaml\Encoders\OntologyAnnotation.fs" />
    <Compile Include="Yaml\Encoders\ValidationPackage.fs" />
    <Compile Include="Yaml\Encoders\ValidationPackagesConfig.fs" />
    <Compile Include="Yaml\Decoders\Cwl.fs" />
    <Compile Include="Yaml\Decoders\Author.fs" />
    <Compile Include="Yaml\Decoders\OntologyAnnotation.fs" />
    <Compile Include="Yaml\Decoders\ValidationPackage.fs" />
    <Compile Include="Yaml\Decoders\ValidationPackagesConfig.fs" />
    <Compile Include="Yaml\CwlYaml.fs" />
    <Compile Include="Yaml\AuthorYaml.fs" />
    <Compile Include="Yaml\OntologyAnnotationYaml.fs" />
    <Compile Include="Yaml\ValidationPackageYaml.fs" />
    <Compile Include="Yaml\ValidationPackagesConfigYaml.fs" />
    <Compile Include="Json\Runtime.fs" />
    <Compile Include="Json\Encoders\Cwl.fs" />
    <Compile Include="Json\Encoders\Author.fs" />
    <Compile Include="Json\Encoders\OntologyAnnotation.fs" />
    <Compile Include="Json\Encoders\ValidationPackage.fs" />
    <Compile Include="Json\Decoders\Cwl.fs" />
    <Compile Include="Json\Decoders\Author.fs" />
    <Compile Include="Json\Decoders\OntologyAnnotation.fs" />
    <Compile Include="Json\Decoders\ValidationPackage.fs" />
    <Compile Include="Json\CwlJson.fs" />
    <Compile Include="Json\AuthorJson.fs" />
    <Compile Include="Json\OntologyAnnotationJson.fs" />
    <Compile Include="Json\ValidationPackageJson.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ValidationPackage.Model\ValidationPackage.Model.fsproj" />
    <PackageReference Include="Fable.Core" Version="5.2.0" />
    <PackageReference Include="YAMLicious" Version="1.0.0" />
    <PackageReference Include="Thoth.Json.Core" Version="0.9.0" />
    <PackageReference Include="Fable.Package.SDK" Version="1.4.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="RELEASE_NOTES.md" />
    <None Include="..\..\schemas\validation-package-frontmatter.schema.json" Link="schemas\validation-package-frontmatter.schema.json" Pack="true" PackagePath="schemas\" />
    <None Include="..\..\schemas\validation-packages.schema.json" Link="schemas\validation-packages.schema.json" Pack="true" PackagePath="schemas\" />
  </ItemGroup>

</Project>
